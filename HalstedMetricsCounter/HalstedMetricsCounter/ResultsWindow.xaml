<Window x:Class="HalstedMetricsCounter.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Результаты"
        Height="720" Width="1100"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="ResultGrid" Grid.Row="0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  GridLinesVisibility="All"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="j"        Binding="{Binding J1}"       Width="60"/>
                <DataGridTextColumn Header="Оператор" Binding="{Binding Operator}" Width="*"/>
                <DataGridTextColumn Header="f1j"      Binding="{Binding F1j}"      Width="80"/>
                <DataGridTextColumn Header="i"        Binding="{Binding J2}"       Width="60"/>
                <DataGridTextColumn Header="Операнд"  Binding="{Binding Operand}"  Width="*"/>
                <DataGridTextColumn Header="f2i"      Binding="{Binding F2j}"      Width="80"/>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTotal}" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Background" Value="#EDEDED"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <TextBlock x:Name="SummaryText" Grid.Row="1"
                   FontFamily="Consolas" FontSize="14"
                   Margin="0,14,0,0" LineHeight="22"/>

        <Button Grid.Row="2" Content="← Назад"
                Click="Back_Click"
                Width="140" Height="34"
                HorizontalAlignment="Left"
                Margin="0,10,0,0"/>
    </Grid>
</Window>